{
  "name": "anchorline",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bunx tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "tauri": "tauri",
    "app": "tauri build",
    "app:test": "VITE_APP_VARIANT=test tauri build --config src-tauri/tauri.test.conf.json",
    "app:dev": "tauri dev",
    "track": "bun run src/cli/track-tui.ts",
    "track:once": "bun run src/cli/track-tui.ts --once",
    "signal": "sh scripts/anchorline-active.sh",
    "backfill": "bun run src/cli/backfill-log.ts",
    "track:frame": "bun run src/cli/track-tui.ts --frame"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "markdown-it": "^15.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "yaml": "^2.9.0"
  }
}
